{
  "name": "@simplevault/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env -- next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint . && next lint --no-cache --quiet",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "bundle-budget": "node scripts/bundle-budget.mjs",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "clean": "rm -rf .next .turbo .tsbuildinfo cypress/screenshots cypress/videos"
  },
  "dependencies": {
    "@simplevault/crypto": "workspace:*",
    "@simplevault/shared": "workspace:*",
    "@simplewebauthn/browser": "^11",
    "@tiptap/core": "^3.22.5",
    "@tiptap/extension-link": "^3.22.5",
    "@tiptap/extension-underline": "^3.22.5",
    "@tiptap/react": "^3.22.5",
    "@tiptap/starter-kit": "^3.22.5",
    "@zxcvbn-ts/core": "^3.0.4",
    "@zxcvbn-ts/language-common": "^3.0.4",
    "@zxcvbn-ts/language-en": "^3.0.2",
    "libsodium-wrappers-sumo": "^0.7.15",
    "next": "^15.5.15",
    "qrcode": "^1.5.4",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "sanitize-html": "^2.17.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@simplevault/eslint-config": "workspace:*",
    "@simplevault/tsconfig": "workspace:*",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/libsodium-wrappers-sumo": "^0.7.0",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sanitize-html": "^2.16.1",
    "@vitejs/plugin-react": "^4",
    "autoprefixer": "^10.4.20",
    "cypress": "^14.0.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.5.15",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.14",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.0",
    "vitest": "^2.1.9"
  }
