# SimpleVault — apps/web build-time environment.
#
# Copy this file to `.env.local` (gitignored) or set the variables in your
# deployment environment. Variables prefixed with `NEXT_PUBLIC_` are
# inlined into the client bundle at build time and are therefore visible
# to anyone who downloads the app — never put secrets here.

# Phase 04 — auto-lock idle timeout in milliseconds.
# After this many ms without a tracked activity event (`pointerdown`,
# `keydown`, `visibilitychange`) the (authed) tree wipes the in-memory
# master_DEK + access JWT and redirects to /login?reason=auto_lock.
# Default 900000 (15 minutes). Set lower (e.g. 60000) in dev to verify
# the flow without waiting 15 minutes.
NEXT_PUBLIC_AUTO_LOCK_IDLE_MS=900000
