{
  "name": "@simplevault/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "simplevault-cli": "./dist/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "clean": "rm -rf dist .tsbuildinfo"
  },
  "dependencies": {
    "@simplevault/crypto": "workspace:*",
    "@simplevault/db": "workspace:*",
    "commander": "^14.0.3",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@simplevault/tsconfig": "workspace:*",
    "@simplevault/eslint-config": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "eslint": "^9.17.0",
    "typescript": "~5.7.0"
  }
}
