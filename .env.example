# ----------------------------------------------------------------------------
# SimpleVault — environment variables
# Copy to `.env` for local dev (or use Dokploy's encrypted env-var UI in prod).
# NEVER commit a real `.env`.
# ----------------------------------------------------------------------------

# ----- Postgres -----
# Local dev (docker compose): defaults below are OK for the bundled postgres.
# Prod (Dokploy managed Postgres 18.3): Dokploy provides the connection string
# directly — set DATABASE_URL to that and ignore POSTGRES_*.
POSTGRES_USER=simplevault
POSTGRES_PASSWORD=changeme_dev_only
POSTGRES_DB=simplevault

# ----- Database connection (used by api) -----
# Local docker-compose uses the service name `postgres`.
# In prod, Dokploy sets this to its managed PG 18.3 connection string.
DATABASE_URL=postgres://simplevault:changeme_dev_only@postgres:5432/simplevault

# ----- Redis (used by api for rate limiting + sessions) -----
# Local docker-compose uses the service name `redis`.
REDIS_URL=redis://redis:6379

# ----- JWT signing (REQUIRED in prod) -----
# Min 32 bytes (256 bits). Generate: `openssl rand -base64 48`
JWT_SECRET=dev_only_replace_in_prod_32bytes_minimum_______

# ----- Audit log HMAC chain secret (REQUIRED in prod) -----
# Min 32 bytes. Used to compute the per-vault hash chain HMAC.
# DO NOT rotate without coordinating with the audit chain re-bootstrap procedure
# (to be defined in Phase 10).
SERVER_CHAIN_SECRET=dev_only_audit_chain_hmac_secret_32bytes_min______

# ----- Invite-code HMAC pepper (REQUIRED in prod for CLI + signup redeem) -----
# Min 32 bytes. The CLI computes HMAC-SHA256(SERVER_INVITE_SECRET, raw_code) and
# stores ONLY the HMAC in `invite_codes.code_hash`. A DB-only compromise cannot
# enumerate raw codes without this pepper. Generate: `openssl rand -base64 32`
# Used by: `pnpm cli invite create` and (Phase 02-07) the POST /auth/signup
# redeem path. Must NOT be the same value as JWT_SECRET or SERVER_CHAIN_SECRET.
SERVER_INVITE_SECRET=dev_only_invite_hmac_pepper_32bytes_min____________

# ----- Recovery-phrase lookup HMAC pepper (REQUIRED in prod) -----
# Min 32 bytes. Server-side outer HMAC over the client-side
# `computeRecoveryLookupHash` so a DB-only compromise can't precompute lookups.
# First consumed by Phase 02-07 (signup) and 02-11 (recovery flow).
# Generate: `openssl rand -base64 32`
SERVER_RECOVERY_HMAC_SECRET=dev_only_recovery_lookup_pepper_32bytes_min__

# ----- Argon2id parameters (REQUIRED in prod) -----
# Operator MUST run `pnpm cli argon2 calibrate` ONCE on the production VPS
# before going live, then paste the printed snippet here / into Dokploy's
# encrypted env-var UI. Target wall time ≈ 750ms per password derivation.
# Conservative floor: ARGON2_MEMORY_KIB=19456, ARGON2_ITERATIONS=2,
# ARGON2_PARALLELISM=1 (OWASP 2024). Values below the floor mean the host
# is too underpowered for production.
ARGON2_MEMORY_KIB=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=1

# ----- CORS allowlist (CSV, no spaces) -----
# Local: just the web dev server. Prod: https://pass.runadev.com (no trailing slash).
CORS_ORIGINS=http://localhost:3000

# ----- Web -> API URL (public, used by browser) -----
# Local: http://localhost:3001
# Prod: https://api.pass.runadev.com OR same-origin via Traefik reverse proxy.
NEXT_PUBLIC_API_URL=http://localhost:3001

# ----- Logging -----
LOG_LEVEL=debug   # use `info` in prod
NODE_ENV=development

# ----- Node runtime ports -----
PORT=3001         # api listen port (web port is set in apps/web Dockerfile to 3000)

# ----------------------------------------------------------------------------
# Phase 02+ will add (do not set yet):
#   COOKIE_DOMAIN, COOKIE_SAMESITE
#   SMTP_* (Phase 07 for vault invites — v1 invite delivery is out-of-band)
#   TURNSTILE_* or HCAPTCHA_* (Phase 02 if we add captcha to signup)
# ----------------------------------------------------------------------------
