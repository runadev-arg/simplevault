# ----------------------------------------------------------------------------
# SimpleVault — environment variables
# Copy to `.env` for local dev (or use Dokploy's encrypted env-var UI in prod).
# NEVER commit a real `.env`.
# ----------------------------------------------------------------------------

# ----- Postgres -----
# Local dev (docker compose): defaults below are OK for the bundled postgres.
# Prod (Dokploy managed Postgres 18.3): Dokploy provides the connection string
# directly — set DATABASE_URL to that and ignore POSTGRES_*.
POSTGRES_USER=simplevault
POSTGRES_PASSWORD=changeme_dev_only
POSTGRES_DB=simplevault

# ----- Database connection (used by api) -----
# Local docker-compose uses the service name `postgres`.
# In prod, Dokploy sets this to its managed PG 18.3 connection string.
DATABASE_URL=postgres://simplevault:changeme_dev_only@postgres:5432/simplevault

# ----- Redis (used by api for rate limiting + sessions) -----
# Local docker-compose uses the service name `redis`.
REDIS_URL=redis://redis:6379

# ----- JWT signing (REQUIRED in prod) -----
# Min 32 bytes (256 bits). Generate: `openssl rand -base64 48`
JWT_SECRET=dev_only_replace_in_prod_32bytes_minimum_______

# ----- Access / refresh token TTLs (seconds) -----
# Defaults: 15 min access, 30 day refresh — REQ-AUTH-001/002.
# Override only if operator has a calibrated reason; shorter access = more
# refresh churn, longer access = bigger blast-radius on stolen-token until
# Phase 03 lands instant-revoke.
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000

# ----- IP-hash HMAC secret (RECOMMENDED in prod) -----
# Min 16 chars (32 B base64 recommended). Used to keyed-HMAC client IPs in
# the user_sessions table + audit logs so a DB dump doesn't yield raw IPs.
# Generate: `openssl rand -base64 32`. If unset, the api falls back to plain
# SHA-256 (dev-friendly) and logs a one-time warning.
SERVER_IP_HASH_SECRET=dev_only_ip_hash_pepper_32bytes_min_______________

# ----- Server argon salt (REQUIRED in prod) -----
# 16 random bytes, base64. Per-deployment salt mixed into every signup's
# server-side argon2 verifier. Generate: `openssl rand -base64 16`.
SERVER_ARGON_SALT=dev_only_server_argon_salt_16B__

# ----- Audit log HMAC chain secret (REQUIRED in prod) -----
# Min 32 bytes. Used to compute the per-vault hash chain HMAC.
# DO NOT rotate without coordinating with the audit chain re-bootstrap procedure
# (to be defined in Phase 10).
SERVER_CHAIN_SECRET=dev_only_audit_chain_hmac_secret_32bytes_min______

# ----- Invite-code HMAC pepper (REQUIRED in prod for CLI + signup redeem) -----
# Min 32 bytes. The CLI computes HMAC-SHA256(SERVER_INVITE_SECRET, raw_code) and
# stores ONLY the HMAC in `invite_codes.code_hash`. A DB-only compromise cannot
# enumerate raw codes without this pepper. Generate: `openssl rand -base64 32`
# Used by: `pnpm cli invite create` and (Phase 02-07) the POST /auth/signup
# redeem path. Must NOT be the same value as JWT_SECRET or SERVER_CHAIN_SECRET.
SERVER_INVITE_SECRET=dev_only_invite_hmac_pepper_32bytes_min____________

# ----- Recovery-phrase lookup HMAC pepper (REQUIRED in prod) -----
# Min 32 bytes. Server-side outer HMAC over the client-side
# `computeRecoveryLookupHash` so a DB-only compromise can't precompute lookups.
# First consumed by Phase 02-07 (signup) and 02-11 (recovery flow).
# Generate: `openssl rand -base64 32`
SERVER_RECOVERY_HMAC_SECRET=dev_only_recovery_lookup_pepper_32bytes_min__

# ----- Argon2id parameters (REQUIRED in prod) -----
# Operator MUST run `pnpm cli argon2 calibrate` ONCE on the production VPS
# before going live, then paste the printed snippet here / into Dokploy's
# encrypted env-var UI. Target wall time ≈ 750ms per password derivation.
# Conservative floor: ARGON2_MEMORY_KIB=19456, ARGON2_ITERATIONS=2,
# ARGON2_PARALLELISM=1 (OWASP 2024). Values below the floor mean the host
# is too underpowered for production.
ARGON2_MEMORY_KIB=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=1

# ----- CORS allowlist (CSV, no spaces) -----
# Local: just the web dev server. Prod: https://pass.runadev.com (no trailing slash).
CORS_ORIGINS=http://localhost:3000

# ----- Web -> API URL (public, used by browser) -----
# Local: http://localhost:3001
# Prod: https://api.pass.runadev.com OR same-origin via Traefik reverse proxy.
NEXT_PUBLIC_API_URL=http://localhost:3001

# ----- Rate-limit ceilings (overridable, all per the named throttler in
# apps/api/src/common/throttler.config.ts). Defaults map to REQ-RATELIMIT-002..006.
# Each ceiling is a positive integer; window/ttl is fixed in code.
# In production leave these unset to use the safe defaults; the env vars
# exist so the E2E harness (Plan 02-12) can disable / tune limits.
GLOBAL_RATE_LIMIT=1000           # default per-IP in 15 min — coarse anti-abuse
LOGIN_IP_RATE_LIMIT=5            # /auth/login per IP per minute
LOGIN_EMAIL_RATE_LIMIT=10        # /auth/login per email per hour
SIGNUP_RATE_LIMIT=3              # /auth/signup per IP per hour
REFRESH_IP_RATE_LIMIT=60         # /auth/refresh per IP per minute
LOGOUT_IP_RATE_LIMIT=60          # /auth/logout per IP per minute
AUTH_PARAMS_RATE_LIMIT=100       # /auth/params per IP per minute
INVITE_REDEEM_RATE_LIMIT=30      # /invite/redeem per IP per hour
ME_RATE_LIMIT=100                # /me per user per minute (post-auth)

# ----- Phase 03 — WebAuthn (REQUIRED in prod) -----
# RP ID = the apex domain hosting the web client. Bound into every passkey
# at registration; changing it invalidates every previously-registered
# passkey (data-migration event). For SimpleVault prod: pass.runadev.com.
# Dev fallback (when unset and NODE_ENV != production): "localhost".
WEBAUTHN_RP_ID=pass.runadev.com
WEBAUTHN_RP_NAME=SimpleVault
# Origin must EXACTLY match the browser's window.location.origin during the
# ceremony. Prod: https://pass.runadev.com. Dev: http://localhost:3000.
# @simplewebauthn/server passes this as `expectedOrigin` — defaults are NOT
# safe; we always pass it explicitly.
WEBAUTHN_ORIGIN=https://pass.runadev.com

# ----- Phase 03 — 2FA throttler ceilings (overridable) -----
TWOFA_REGISTER_RATE_LIMIT=10        # /2fa/*/{begin,finish}-register per user per minute
TWOFA_WEBAUTHN_AUTH_RATE_LIMIT=30   # /2fa/webauthn/{begin,finish}-auth per IP per minute

# ----- Phase 03 — 2FA step-up token TTL (seconds) -----
# Lifetime of the JWT issued by /auth/login when the user has ≥1 2FA method
# enrolled. The token is single-purpose (purpose:"2fa-stepup") and only
# accepted on /2fa/* routes. Default 120s — long enough for the user to open
# their authenticator + type the code; short enough that a stolen step-up
# token is useless before the ceremony completes.
STEP_UP_TOKEN_TTL=120

# ----- Logging -----
LOG_LEVEL=debug   # use `info` in prod
NODE_ENV=development

# ----- Node runtime ports -----
PORT=3001         # api listen port (web port is set in apps/web Dockerfile to 3000)

# ----------------------------------------------------------------------------
# Phase 02+ will add (do not set yet):
#   COOKIE_DOMAIN, COOKIE_SAMESITE
#   SMTP_* (Phase 07 for vault invites — v1 invite delivery is out-of-band)
#   TURNSTILE_* or HCAPTCHA_* (Phase 02 if we add captcha to signup)
# ----------------------------------------------------------------------------
